# ==============================================================================
# Propheta - Default Development Values
# These values are safe for local development.
# DO NOT put secrets here.
# ==============================================================================

# === PROJECT ===
NODE_ENV=development
PORT=5000

# === DATABASE (Root/System) ===
POSTGRES_DB=propheta
POSTGRES_USER=propheta
POSTGRES_PASSWORD=1234

# === DATABASE (Application) ===
DB_HOST=db
DB_PORT=5432
DB_NAME=propheta
DB_USER=app_user
DB_PASSWORD=1234
DB_POOL_MAX=10

# === REDIS ===
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_pass

# === AUTHENTICATION ===
SALT_ROUNDS=10
TIME_ACCESS_TOKEN_LAST=15m
TIME_REFRESH_TOKEN_LAST=7d

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
