# ==============================================================================
# Propheta - Default Development Values
# These values are safe for local development.
# DO NOT put secrets here.
# ==============================================================================

# === PROJECT ===
NODE_ENV=development
PORT=5000

# === DATABASE (Root/System) ===
POSTGRES_DB=propheta
POSTGRES_USER=propheta
POSTGRES_PASSWORD=1234

# === DATABASE (Application) ===
DB_HOST=db
DB_PORT=5432
DB_NAME=propheta
DB_USER=app_user
DB_PASSWORD=1234
DB_POOL_MAX=10

# === REDIS ===
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_pass

# === AUTHENTICATION ===
SALT_ROUNDS=10
TIME_ACCESS_TOKEN_LAST=15m
TIME_REFRESH_TOKEN_LAST=7d

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# === X (TWITTER) API ===
# Points at the x-api-mock service by default; no real X credentials in dev.
X_API_BASE_URL=http://x-api-mock:4100
X_WEBHOOK_CONSUMER_SECRET=dev_webhook_consumer_secret

# === AGENT (ANTHROPIC) ===
# No safe default for ANTHROPIC_API_KEY — it is a real credential, left unset.
# The agent module no-ops in development without one.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=16000
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=10

# === KALSHI API ===
# Demo environment by default; no real money. No safe defaults for
# KALSHI_API_KEY_ID / KALSHI_PRIVATE_KEY - they are real credentials, left
# unset. The Kalshi client throws on first use in development without them.
KALSHI_API_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_TIMEOUT_MS=10000

# === SCRAPE CACHE (REDIS) ===
SCRAPE_CACHE_TTL_SECONDS=21600
SCRAPE_CACHE_NEGATIVE_TTL_SECONDS=900

# === TRADING SAFETY ===
DRY_RUN=true

# === TRADING (docs/backend/trading.md) ===
TRADE_MIN_CONFIDENCE=0.6
MAX_SPREAD_CENTS=4
MAX_SLIPPAGE_CENTS=10
MIN_NET_EDGE_CENTS=2
MAX_TRADE_EXPOSURE_PCT=2
MAX_TOPIC_EXPOSURE_PCT=5
MAX_DAILY_LOSS_PCT=5
MAX_ORDERS_PER_MINUTE=3
SELECTION_MAX_ITERATIONS=2
SELECTION_MAX_TOOL_CALLS=6
TRADE_NOVELTY_WINDOW_HOURS=6
TRADE_MAX_CANDIDATES=10
TRADE_MIN_HORIZON_MINUTES=5
TRADE_HORIZON_MINUTES=4320
TRADE_MIN_SERIES_VOLUME=100
TRADE_CAPITAL_BASE_CENTS=100000
TRADE_BALANCE_CACHE_MS=60000
QUOTE_POLL_ENABLED=true
QUOTE_POLL_INTERVAL_MS=2000
QUOTE_SAMPLE_TTL_SECONDS=3600
MARKET_CACHE_REFRESH_MS=300000
EXIT_HORIZON_MODEL_WEIGHT=0
EXIT_HORIZON_SYSTEM=ATR
EXIT_HORIZON_MIN_MINUTES=5
EXIT_HORIZON_MAX_MINUTES=1440
EXIT_CLOSE_BUFFER_MINUTES=30
EXIT_ATR_PERIOD=14
EXIT_ATR_BAR_SECONDS=60
EXIT_ATR_MIN_BARS=10
EXIT_ATR_HORIZON_MULTIPLIER=2.0
EXIT_STOP_LOSS_ATR_MULTIPLIER=2.0
EXIT_STOP_LOSS_MIN_CENTS=3
EXIT_STOP_LOSS_MAX_CENTS=15
EXIT_TAKE_PROFIT_EDGE_FRACTION=0.7
EXIT_TAKE_PROFIT_MIN_NET_CENTS=2
EXIT_SURVIVAL_PERCENTILE=75
EXIT_SWEEP_INTERVAL_MS=5000
EXIT_SLIPPAGE_CENTS=5
