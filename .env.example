# ==============================================================================
# Propheta - Environment Variables Template
# Copy this file to .env and fill in the values.
# ==============================================================================

# === PROJECT ===
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000

# === DATABASE (Root/System) ===
# Used by the 'db' and 'db-init' services to create the database
POSTGRES_DB=propheta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# === DATABASE (Application) ===
# Used by the 'backend' service to connect to the database
DB_HOST=db
DB_PORT=5432
DB_NAME=propheta
DB_USER=app_user
DB_PASSWORD=
DB_POOL_MAX=10

# === REDIS ===
REDIS_PORT=6379
REDIS_PASSWORD=

# === AUTHENTICATION ===
# Security keys and token expiration
SALT_ROUNDS=10
SECRET_KEY=
TIME_ACCESS_TOKEN_LAST=15m
TIME_REFRESH_TOKEN_LAST=7d

# Single admin user, created by running:
#   pnpm --prefix backend ts-node src/shared/scripts/createAdminUser.ts
# There is no self-registration endpoint.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# === CORS ===
# Comma separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# === X (TWITTER) API ===
# In local/dev/test, points at the x-api-mock service, not the real X API.
X_API_BASE_URL=http://x-api-mock:4100
X_WEBHOOK_CONSUMER_SECRET=
X_BEARER_TOKEN=
# Publicly reachable URL X delivers webhook events to (used to register the
# webhook via POST /api/webhooks/x/registration). Required, no safe default:
# the real X API rejects URLs with a port number, so this must be set per
# environment (e.g. an HTTPS tunnel in dev, your real domain in production).
X_WEBHOOK_TARGET_URL=

# === AGENT (ANTHROPIC) ===
# Post-ingestion analysis loop. Required outside development; in development
# the stack still boots without it, but runPostAnalysis no-ops with a warn.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only set to repoint the SDK at a local mock (e.g. in tests).
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=16000
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=10

# === KALSHI API ===
# Prediction market venue. Switch this single URL between demo and production:
#   demo: https://external-api.demo.kalshi.co/trade-api/v2
#   prod: https://external-api.kalshi.com/trade-api/v2
# The /trade-api/v2 prefix is part of the value: Kalshi signs the full path
# from the API root, so the prefix must be present.
KALSHI_API_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
# API key id from Account & security > API Keys. Credentials are per
# environment: demo keys only work against demo. Required outside development.
KALSHI_API_KEY_ID=
# RSA private key PEM downloaded when the key was created, on a single line
# with literal \n between the lines. Never commit the real value.
KALSHI_PRIVATE_KEY=
KALSHI_TIMEOUT_MS=10000

# === SCRAPE CACHE (REDIS) ===
# How long a scraped page is cached. Negative entries (dead/blocked links)
# use a shorter TTL so a transient failure is retried sooner.
SCRAPE_CACHE_TTL_SECONDS=21600
SCRAPE_CACHE_NEGATIVE_TTL_SECONDS=900

# === TRADING SAFETY ===
# Pipeline runs end to end without sending real orders.
DRY_RUN=true

# === TRADING (docs/backend/trading.md) ===
# Gate thresholds
TRADE_MIN_CONFIDENCE=0.6
MAX_SPREAD_CENTS=4
MAX_SLIPPAGE_CENTS=10
MIN_NET_EDGE_CENTS=2
MAX_TRADE_EXPOSURE_PCT=2
MAX_TOPIC_EXPOSURE_PCT=5
MAX_DAILY_LOSS_PCT=5
MAX_ORDERS_PER_MINUTE=3
SELECTION_MAX_ITERATIONS=2
SELECTION_MAX_TOOL_CALLS=6
TRADE_NOVELTY_WINDOW_HOURS=6
TRADE_MAX_CANDIDATES=10
TRADE_MIN_HORIZON_MINUTES=5
TRADE_HORIZON_MINUTES=4320
TRADE_MIN_SERIES_VOLUME=100
# Capital base for exposure math. No live-balance override in v1 (documented
# follow-up) -- this value is the source of truth.
TRADE_CAPITAL_BASE_CENTS=100000
TRADE_BALANCE_CACHE_MS=60000
# Quote feed: REST polling for v1 (docs/backend/tradeDecision.md's "Quote
# feed" decision), never the raw markets/orderbooks endpoint on demand.
QUOTE_POLL_ENABLED=true
QUOTE_POLL_INTERVAL_MS=2000
QUOTE_SAMPLE_TTL_SECONDS=3600
MARKET_CACHE_REFRESH_MS=300000
# Exit policy (docs/backend/tradeDecision.md "Exit policy")
EXIT_HORIZON_MODEL_WEIGHT=0
EXIT_HORIZON_SYSTEM=ATR
EXIT_HORIZON_MIN_MINUTES=5
EXIT_HORIZON_MAX_MINUTES=1440
EXIT_CLOSE_BUFFER_MINUTES=30
EXIT_ATR_PERIOD=14
EXIT_ATR_BAR_SECONDS=60
EXIT_ATR_MIN_BARS=10
EXIT_ATR_HORIZON_MULTIPLIER=2.0
EXIT_STOP_LOSS_ATR_MULTIPLIER=2.0
EXIT_STOP_LOSS_MIN_CENTS=3
EXIT_STOP_LOSS_MAX_CENTS=15
EXIT_TAKE_PROFIT_EDGE_FRACTION=0.7
EXIT_TAKE_PROFIT_MIN_NET_CENTS=2
EXIT_SURVIVAL_PERCENTILE=75
EXIT_SWEEP_INTERVAL_MS=5000
# Open decision 8: marketable-limit exit bound, needs confirmation against a
# live Kalshi account before DRY_RUN=false is used for real capital.
EXIT_SLIPPAGE_CENTS=5
