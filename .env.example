# ==============================================================================
# Propheta - Environment Variables Template
# Copy this file to .env and fill in the values.
# ==============================================================================

# === PROJECT ===
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000

# === DATABASE (Root/System) ===
# Used by the 'db' and 'db-init' services to create the database
POSTGRES_DB=propheta
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# === DATABASE (Application) ===
# Used by the 'backend' service to connect to the database
DB_HOST=db
DB_PORT=5432
DB_NAME=propheta
DB_USER=app_user
DB_PASSWORD=
DB_POOL_MAX=10

# === REDIS ===
REDIS_PORT=6379
REDIS_PASSWORD=

# === AUTHENTICATION ===
# Security keys and token expiration
SALT_ROUNDS=10
SECRET_KEY=
TIME_ACCESS_TOKEN_LAST=15m
TIME_REFRESH_TOKEN_LAST=7d

# === CORS ===
# Comma separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
